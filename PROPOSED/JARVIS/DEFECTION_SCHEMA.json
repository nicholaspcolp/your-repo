{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Defection",
  "type": "object",
  "properties": {
    "timestamp": {"type":"string","format":"date-time"},
    "run_id": {"type":"string"},
    "actor": {"type":"string"},
    "summary": {"type":"string"},
    "details": {"type":"string"},
    "tags": {"type":"string"},
    "severity": {"type":"string","enum":["low","medium","high"]},
    "status": {"type":"string","enum":["open","triaged","closed"]}
  },
  "required": ["timestamp","summary","actor"]
}
